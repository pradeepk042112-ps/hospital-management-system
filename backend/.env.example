# Copy these variable names into backend/.env and keep real credentials private.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_management

# Local development only: show a generated OTP in the browser instead of sending SMS.
# Demo mode is disabled automatically in production and when Twilio Verify is configured.
DEMO_OTP_ENABLED=true

# Appointment SMS is simulated locally when Twilio Messaging is not configured.
# Simulation is disabled automatically in production; set false to disable it locally.
DEMO_SMS_ENABLED=true

# Twilio Verify credentials (create a Verify Service in the Twilio Console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Programmable Messaging (appointment confirmations and reminders).
# Configure a sender pool and use its Messaging Service SID; alternatively set a Twilio SMS sender number.
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM_NUMBER=+1...
